# Virtual environments and caches
.venv/
venv/
.uvcache/
__pycache__/
*.py[cod]

# Scratch space used while developing and verifying
.scratch/

# OS noise
.DS_Store
:memory:.ses

# Redundant archives (the extracted model is committed instead)
models/verne_rnn_model.keras.zip

# A partial duplicate of the project, created when the Colab notebook uploaded
# books/ and vernebot/ from a zip. The originals live at the repository root.
files/

# The duplicate weight files inside Train results/: the models themselves are in
# models/. The JSON run records stay, since they are the training history.
Train results/*.h5

# The retraining working directory: the weights that matter were copied into
# models/, and the .keras/.h5 here are byte-identical duplicates. The JSON run
# records and the logs are kept, since they are the training history.
models_v2/*.keras
models_v2/*.h5
models_v2/seeds/*.h5
models_v2/*.ipynb

# The 2024 models, superseded by the retrained ones. They stay in git history
# (commit 738abab) and on disk locally; there is no reason to store them twice.
models/legacy-2024/

# The lecture slides: kept locally, not published with the code.
15-Text_Generation_verne_bot.pdf
